---
import '@fontsource/ibm-plex-sans-kr/300.css';
import '@fontsource/ibm-plex-sans-kr/400.css';
import '@fontsource/ibm-plex-sans-kr/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Cable from '../components/Cable.astro';
import { SITE, CATEGORIES, type Category } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title}, ${SITE.name}` : SITE.title;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: '소개' },
  { href: '/projects/', label: '프로젝트' },
  ...(SITE.showBlog ? [{ href: '/blog/', label: '블로그' }] : []),
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const githubLabel = SITE.github.replace(/^https?:\/\//, '');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="shell">
      <a class="name" href="/">{SITE.name}</a>
      <nav aria-label="주요 메뉴">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="grid">
      <slot />
    </main>

    <footer>
      <div class="grid inner">
        <h2>{SITE.closing}</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>이메일<span>{SITE.email}</span></a></li>
          <li><a href={SITE.github}>GitHub<span>{githubLabel}</span></a></li>
        </ul>
        <div class="legend">
          {
            (Object.keys(CATEGORIES) as Category[]).map((key) => (
              <span>
                <Cable category={key} />
                {CATEGORIES[key]}
              </span>
            ))
          }
          <span class="why">분야 색은 랜선 T568B 배열에서 가져왔습니다.</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .shell {
    background: var(--inverse);
    color: var(--inverse-ink);
    height: 48px;
    display: flex;
    align-items: stretch;
  }
  .name {
    display: flex;
    align-items: center;
    padding: 0 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--inverse-ink);
    border-right: 1px solid var(--inverse-surface);
  }
  nav {
    display: flex;
    margin-left: auto;
  }
  nav a {
    display: flex;
    align-items: center;
    padding: 0 16px;
    font-size: 14px;
    color: var(--inverse-muted);
  }
  nav a[aria-current='page'] {
    color: var(--inverse-ink);
    box-shadow: inset 0 -3px 0 var(--blue);
  }
  nav a:hover {
    background: #353535;
    text-decoration: none;
  }

  footer {
    background: var(--inverse);
    color: var(--inverse-muted);
    margin-top: 96px;
  }
  .inner {
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    column-gap: 32px;
    padding-top: 48px;
    padding-bottom: 48px;
  }
  footer h2 {
    grid-column: 1 / 9;
    font-size: 42px;
    font-weight: 300;
    line-height: 1.2;
    color: var(--inverse-ink);
    margin: 0;
  }
  footer ul {
    grid-column: 9 / 17;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }
  footer li {
    border-bottom: 1px solid var(--inverse-surface);
  }
  footer li a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    color: var(--inverse-ink);
  }
  footer li span {
    color: var(--inverse-muted);
    font-family: var(--mono);
    font-size: 13px;
  }
  .legend {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 64px;
    padding-top: 16px;
    border-top: 1px solid var(--inverse-surface);
    font-size: 12px;
    letter-spacing: 0.32px;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
  }
  .legend .why {
    margin-left: auto;
  }

  @media (max-width: 66rem) {
    .inner {
      display: block;
    }
    footer ul {
      margin-top: 32px;
    }
    .legend .why {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
  @media (max-width: 42rem) {
    footer h2 {
      font-size: 30px;
    }
  }
</style>
