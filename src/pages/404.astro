---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없음">
  <section class="block">
    <div class="head">
      <p class="code">404</p>
    </div>
    <div class="body">
      <h1>페이지를 찾을 수 없어요.</h1>
      <p><a href="/">홈으로 가기</a></p>
    </div>
  </section>
</Base>

<style>
  .code {
    font-family: var(--mono);
    color: var(--ink-muted);
    margin: 0;
  }
  h1 {
    font-size: 42px;
    font-weight: 300;
    margin: 0 0 16px;
  }
</style>
