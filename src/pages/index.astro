---
import Base from '../layouts/Base.astro';
import Cable from '../components/Cable.astro';
import HomelabDiagram from '../components/HomelabDiagram.astro';
import ProjectTiles from '../components/ProjectTiles.astro';
import { SITE, TOOLS, LANGUAGES, PATH } from '../config';
import { getProjects, getPosts, formatDate } from '../lib/content';

const projects = await getProjects();
const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="text">
      <p class="who"><strong>{SITE.name}</strong>{SITE.role}</p>
      <h1>{SITE.headline}</h1>
      <p class="intro">{SITE.intro}</p>
      <div class="actions">
        <a class="btn" href="#projects">프로젝트 보기</a>
        <a class="btn secondary" href={SITE.github}>GitHub</a>
      </div>
    </div>
    <div class="figure">
      <HomelabDiagram />
    </div>
  </section>

  <section class="block" id="projects">
    <div class="head">
      <h2>프로젝트</h2>
      <p>혼자 만든 것과 팀으로 만든 것을 구분하고, 팀 프로젝트는 제가 커밋한 부분만 적었습니다.</p>
    </div>
    <div class="body">
      <ProjectTiles projects={projects} />
    </div>
  </section>

  <section class="block">
    <div class="head">
      <h2>다루는 도구</h2>
    </div>
    <div class="body">
      <table>
        <thead><tr><th>분야</th><th>도구</th><th>써 본 곳</th></tr></thead>
        <tbody>
          {
            TOOLS.map((row) => (
              <tr>
                <td class="label"><Cable category={row.category} />{row.label}</td>
                <td>{row.items}</td>
                <td class="where">{row.where}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="note">{LANGUAGES}</p>
    </div>
  </section>

  <section class="block" id="path">
    <div class="head">
      <h2>걸어온 길</h2>
    </div>
    <div class="body">
      <ol class="path">
        {
          PATH.map((step) => (
            <li>
              <time>{step.when}</time>
              <div>
                <strong>{step.title}</strong>
                <p>{step.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="block">
        <div class="head">
          <h2>최근 글</h2>
        </div>
        <div class="body">
          <ol class="path">
            {posts.map((post) => (
              <li>
                <time>{formatDate(post.data.date)}</time>
                <div>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    column-gap: 32px;
    padding: 80px 0;
    border-bottom: 1px solid var(--hairline);
    align-items: start;
  }
  .text {
    grid-column: 1 / 8;
  }
  .figure {
    grid-column: 8 / 17;
  }
  .who {
    font-size: 14px;
    color: var(--ink-muted);
    margin: 0 0 24px;
  }
  .who strong {
    color: var(--ink);
    font-weight: 600;
    margin-right: 8px;
  }
  h1 {
    font-size: 52px;
    font-weight: 300;
    line-height: 1.17;
    letter-spacing: -0.4px;
    margin: 0 0 28px;
  }
  .intro {
    font-size: 18px;
    color: var(--ink-muted);
    margin: 0 0 40px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
  }

  td.label {
    white-space: nowrap;
  }
  td.where {
    color: var(--ink-muted);
    white-space: nowrap;
  }
  tbody tr:hover td {
    background: var(--surface-1);
  }

  .path {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .path li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .path time {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-muted);
    padding-top: 2px;
  }
  .path strong {
    font-weight: 400;
    font-size: 16px;
  }
  .path p {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--ink-muted);
  }

  @media (max-width: 66rem) {
    .hero {
      display: block;
    }
    .figure {
      margin-top: 48px;
    }
  }
  @media (max-width: 42rem) {
    .hero {
      padding: 48px 0;
    }
    h1 {
      font-size: 34px;
    }
    td.label,
    td.where {
      white-space: normal;
    }
    .path li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
