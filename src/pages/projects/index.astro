---
import Base from '../../layouts/Base.astro';
import ProjectTiles from '../../components/ProjectTiles.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="프로젝트" description="직접 설계하고 구축한 인프라 프로젝트">
  <section class="block">
    <div class="head">
      <h1>프로젝트</h1>
      <p>혼자 만든 것과 팀으로 만든 것을 구분하고, 팀 프로젝트는 제가 커밋한 부분만 적었습니다.</p>
    </div>
    <div class="body">
      <ProjectTiles projects={projects} />
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: 32px;
    font-weight: 300;
    margin: 0 0 8px;
  }
</style>
