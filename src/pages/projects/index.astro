---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="프로젝트" description="직접 설계하고 구축한 인프라 프로젝트">
  <h1>프로젝트</h1>
  <p class="lead">직접 설계하고, 코드로 만들고, 운영해 본 것들입니다.</p>
  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>

<style>
  h1 {
    margin: 0 0 0.5rem;
  }
  .lead {
    color: var(--muted);
    margin: 0 0 2rem;
  }
  .grid {
    display: grid;
    gap: 0.9rem;
  }
</style>
