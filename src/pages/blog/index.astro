---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { getPosts, formatDate } from '../../lib/content';

// 블로그가 꺼져 있으면 이 페이지는 홈으로 보냅니다.
if (!SITE.showBlog) return Astro.redirect('/');

const posts = await getPosts();
---

<Base title="블로그" description="작업하며 배운 것과 트러블슈팅 기록">
  <section class="block">
    <div class="head">
      <h1>블로그</h1>
      <p>작업하며 배운 것, 막혔던 것, 해결한 것.</p>
    </div>
    <div class="body">
      {posts.length === 0 && <p class="empty">아직 글이 없습니다.</p>}
      <ol class="list">
        {
          posts.map((post) => (
            <li>
              <time>{formatDate(post.data.date)}</time>
              <div>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                {post.data.description && <p>{post.data.description}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: 32px;
    font-weight: 300;
    margin: 0 0 8px;
  }
  .empty {
    color: var(--ink-muted);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }
  time {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-muted);
    padding-top: 2px;
  }
  li p {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--ink-muted);
  }
  @media (max-width: 42rem) {
    li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
